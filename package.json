{
  "name": "crudo-v1",
  "version": "1.0.0",
  "private": true,
  "description": "CRUDO QUESOS S.L.U — Tienda de quesos y cheese bar Madrid. Web V1.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,yellow \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server.js",
    "dev:client": "vite",
    "build": "vite build",
    "build:check": "node -e \"const fs=require('fs'); if(!fs.existsSync('dist/index.html')){console.log('[build:check] dist/index.html no existe — ejecuta `npm run build` antes de deploy.'); process.exit(1)} else {console.log('[build:check] dist/index.html OK'); process.exit(0)}\"",
    "preview": "vite preview --port 4173",
    "start": "node server.js",
    "lint": "eslint server/ db/ tests/ server.js src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "vitest run tests/",
    "test:client": "vitest run src/",
    "check": "npm run lint && npm test",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "db:reset": "node db/reset.js",
    "deploy:plesk:notes": "node -e \"const fs=require('fs');for(const f of ['infra/plesk/README.md','infra/scripts/deploy-checklist.md','infra/scripts/backup-notes.md']){if(fs.existsSync(f)){console.log('\\n=== '+f+' ===\\n');process.stdout.write(fs.readFileSync(f,'utf8'))}}\""
  },
  "dependencies": {
    "axios": "^1.16.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.460.0",
    "mariadb": "^3.3.1",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^6.30.3",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^25.0.1",
    "nodemon": "^3.1.3",
    "postcss": "^8.5.14",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.2",
    "vitest": "^1.6.0"
  }
}
