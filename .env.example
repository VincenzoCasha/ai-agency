# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CLIENT_DEV_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── Database (MariaDB) ───────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crudo
DB_USER=crudo
DB_PASSWORD=change_me

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=change_me_min_32_chars

# ─── Uploads ──────────────────────────────────────────────────────────────────
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=8

# ─── Email (Brevo / nodemailer) ───────────────────────────────────────────────
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Owner contact ────────────────────────────────────────────────────────────
OWNER_WHATSAPP=
OWNER_EMAIL=

# ─── Frontend env vars (exposed via Vite) ─────────────────────────────────────
VITE_API_BASE=/api/v1
VITE_GA_ID=
VITE_META_PIXEL=
VITE_PUBLIC_WHATSAPP=
VITE_GOOGLE_MAPS_URL=

# ─── V2 only — disabled in V1 (do not activate) ──────────────────────────────
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLIC_KEY=
