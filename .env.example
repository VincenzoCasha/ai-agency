# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CLIENT_DEV_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# URLs publicas (informativas, usadas en docs/health/sitemap futuros)
PUBLIC_BASE_URL=http://localhost:3000
STAGING_BASE_URL=

# ─── Database (MariaDB) ───────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crudo_dev
DB_USER=crudo
DB_PASSWORD=change_me
# Override opcional usado por scripts/tests (ej: DB_OVERRIDE=crudo_test)
DB_OVERRIDE=
# Nombre de la DB de test usada por vitest cuando se ejecuten tests con DB real
DB_TEST_NAME=crudo_test

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=change_me_min_32_chars

# ─── Uploads ──────────────────────────────────────────────────────────────────
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=8

# ─── Email (Brevo / nodemailer) ───────────────────────────────────────────────
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Owner contact ────────────────────────────────────────────────────────────
OWNER_WHATSAPP=
OWNER_EMAIL=

# ─── Public site config (consumido por GET /api/v1/site/config) ──────────────
PUBLIC_WHATSAPP=
PUBLIC_INSTAGRAM=https://www.instagram.com/crudomov
PUBLIC_GOOGLE_MAPS_URL=

# ─── Frontend env vars (exposed via Vite, leidas en build) ────────────────────
VITE_API_BASE=/api/v1
# Dominio canonico para SEO (canonical, OG, sitemap). Prod: https://crudomov.es
VITE_SITE_URL=https://crudomov.es
VITE_GA_ID=
VITE_META_PIXEL=
VITE_PUBLIC_WHATSAPP=
VITE_GOOGLE_MAPS_URL=

# ─── V2 only — disabled in V1 (do not activate) ──────────────────────────────
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLIC_KEY=
