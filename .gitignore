# Dependencies
node_modules/

# Build output
dist/
build/

# Environment — never commit real secrets
.env
.env.*
!.env.example

# Uploads — keep .gitkeep, ignore real files
uploads/*
!uploads/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime
pids/
*.pid
*.seed
*.pid.lock

# Cache
.cache/
.parcel-cache/
.vite/
.eslintcache

# OS
.DS_Store
Thumbs.db

# Claude Code (worktrees, launch config — local only)
.claude/

# IDEs (config files OK, generated files not)
.idea/
*.iml
.vscode/settings.json
.vscode/launch.json

# Test coverage
coverage/

# Playwright E2E (Fase 9)
playwright-report/
test-results/
blob-report/
.playwright/

# Temporary
tmp/
temp/
